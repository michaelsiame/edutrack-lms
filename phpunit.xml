<?xml version="1.0" encoding="UTF-8"?>
<!--
  The migrations do not build a fresh database (a 2026-05-25 migration adds a
  column that already exists), so tests run against an empty copy of the local
  schema, inside a transaction per test:
    mysqldump with no-data and set-gtid-purged=OFF from edutrack_local, piped into edutrack_lms_test
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="edutrack_lms_test" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="LIPILA_API_KEY" value="test-key" force="true"/>
        <env name="LIPILA_BASE_URL" value="https://lipila.test" force="true"/>
    </php>
</phpunit>
